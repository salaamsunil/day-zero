---
// The catchy pure-CSS "order card" mockup (tilted receipt + now-serving chip).
// Styles live in global.css as .order-mock*. Decorative, so aria-hidden.
---
<div class="order-mock" aria-hidden="true">
    <div class="order-mock-card">
        <div class="order-mock-head">
            <span class="order-mock-truck"><span class="order-mock-dot"></span> Rosa's Tacos</span>
            <span class="order-mock-wait"><i class="fas fa-clock"></i> 6 min wait</span>
        </div>
        <div class="order-mock-ticket">
            <p class="order-mock-label">Your order</p>
            <p class="order-mock-number">#42</p>
            <p class="order-mock-ready"><i class="fas fa-circle-check"></i> Ready for pickup</p>
        </div>
        <div class="order-mock-foot">
            <span>2&times; Carnitas, 1&times; Horchata</span>
            <span class="order-mock-total">$26.00</span>
        </div>
    </div>
    <div class="order-mock-board">
        <p class="order-mock-board-label">Now serving</p>
        <p class="order-mock-board-nums">41 &middot; 42 &middot; 43</p>
    </div>
</div>
