---
// QueueZero is a two-device product: customers order on a phone (dark UI),
// vendors run the truck on a tablet (light UI). Both sides are paginated
// ShotGalleries (thumbnails + crossfade, mobile-safe): a phone-framed gallery
// for the customer views, a browser-framed gallery for the operator views.
import ShotGallery from './ShotGallery.astro';
import phoneOrder from '../assets/products/QueueZero/qz-phone-order.png';
import geolocator from '../assets/products/QueueZero/qz-geolocator.png';
import kds from '../assets/products/QueueZero/qz-kds.png';
import board from '../assets/products/QueueZero/qz-board.png';
import analytics from '../assets/products/QueueZero/qz-analytics.png';
import qrSign from '../assets/products/QueueZero/qz-qr-sign.png';

const customerShots = [
    { src: phoneOrder, alt: 'QueueZero customer ordering on a phone: live wait time, menu, and add to order', label: 'order ahead' },
    { src: geolocator, alt: 'QueueZero customer map: food trucks open near you, with live wait times', label: 'trucks near you' },
];
const operatorShots = [
    { src: kds, alt: 'QueueZero kitchen display: live order tickets moving through cook and ready states', label: 'kitchen display' },
    { src: board, alt: 'QueueZero now-serving board: ready pickup numbers, big and bright', label: 'now-serving board' },
    { src: analytics, alt: 'QueueZero vendor analytics: orders, revenue, and the busiest hour', label: 'analytics' },
    { src: qrSign, alt: 'QueueZero print-ready QR order sign for the truck and A-frame', label: 'QR sign' },
];
---
<div class="qz-showcase">
    <div class="qz-phone-col">
        <ShotGallery url="queuezero.app" variant="phone" ratio="2 / 3" images={customerShots} />
        <p class="qz-cap">What your customer sees</p>
    </div>
    <div class="qz-operator">
        <ShotGallery url="queuezero.app" ratio="3 / 2" images={operatorShots} />
        <p class="qz-cap">What you run at the truck</p>
    </div>
</div>

<style>
    .qz-showcase {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 1.75rem;
        margin: 1.75rem 0;
    }
    .qz-phone-col { flex: 0 0 210px; max-width: 210px; }
    .qz-operator { flex: 1 1 340px; min-width: 0; }
    .qz-cap {
        color: var(--gray);
        font-size: 0.75rem;
        text-align: center;
        margin-top: 0.7rem;
    }
    @media (max-width: 700px) {
        .qz-showcase { flex-direction: column; align-items: center; }
        .qz-phone-col { flex-basis: auto; max-width: 240px; order: 2; }
        .qz-operator { width: 100%; order: 1; }
    }
</style>
