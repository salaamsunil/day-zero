---
// QueueZero is a two-device product: customers order on a phone (dark UI),
// vendors run the truck on a browser (light UI). Both sides show as plain
// galleries of pre-rendered device mockups (floating device + soft shadow on a
// warm premium ground), crossfaded with thumbnails. The frame/shadow/ground is
// baked into each mockup image, so the gallery adds no chrome (variant="plain").
import ShotGallery from './ShotGallery.astro';
import phoneOrder from '../assets/products/QueueZero/mockups/qz-phone-order.png';
import geolocator from '../assets/products/QueueZero/mockups/qz-geolocator.png';
import tracker from '../assets/products/QueueZero/mockups/qz-tracker.png';
import eventPage from '../assets/products/QueueZero/mockups/qz-event.png';
import kds from '../assets/products/QueueZero/mockups/qz-kds.png';
import board from '../assets/products/QueueZero/mockups/qz-board.png';
import analytics from '../assets/products/QueueZero/mockups/qz-analytics.png';
import qrSign from '../assets/products/QueueZero/mockups/qz-qr-sign.png';

const customerShots = [
    { src: phoneOrder, alt: 'QueueZero customer ordering on a phone: live wait time, menu, and add to order', label: 'order ahead' },
    { src: geolocator, alt: 'QueueZero customer map: food trucks open near you, with live wait times', label: 'trucks near you' },
    { src: tracker, alt: 'QueueZero customer order tracker: order number, status, and pickup countdown', label: 'track the order' },
    { src: eventPage, alt: 'QueueZero event page: all the trucks at a market, each with its live wait', label: 'event page' },
];
const operatorShots = [
    { src: kds, alt: 'QueueZero kitchen display: live order tickets moving through cook and ready states', label: 'kitchen display' },
    { src: board, alt: 'QueueZero now-serving board: ready pickup numbers, big and bright', label: 'now-serving board' },
    { src: analytics, alt: 'QueueZero vendor analytics: orders, revenue, and the busiest hour', label: 'analytics' },
    { src: qrSign, alt: 'QueueZero print-ready QR order sign for the truck and A-frame', label: 'QR sign' },
];
---
<div class="qz-showcase">
    <div class="qz-col">
        <ShotGallery url="queuezero.app" variant="plain" ratio="4 / 3" images={customerShots} />
        <p class="qz-cap">What your customer sees</p>
    </div>
    <div class="qz-col">
        <ShotGallery url="queuezero.app" variant="plain" ratio="4 / 3" images={operatorShots} />
        <p class="qz-cap">What you run at the truck</p>
    </div>
</div>

<style>
    .qz-showcase {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 1.5rem;
        margin: 1.5rem 0;
    }
    .qz-col { flex: 1 1 300px; min-width: 0; }
    .qz-col :global(.shot-gallery) { max-width: none; }
    .qz-cap {
        color: var(--gray);
        font-size: 0.75rem;
        text-align: center;
        margin-top: 0.7rem;
    }
    @media (max-width: 700px) {
        .qz-showcase { flex-direction: column; align-items: stretch; }
    }
</style>
