---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
    title,
    description,
    canonical,
    ogTitle,
    ogDescription,
    ogImage = 'https://day-zero.com.au/images/og-image.png',
    bodyClass = '',
    isHome = false,
    noindex = false,
} = Astro.props;

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="IumsWJs639g1J-MhseCcdJ6FuM9--V6al5A0vYXJKWM" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content="en_AU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/dazero-tile.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Preconnect for external resources -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />

    <!-- Self-hosted Inter: preload the two above-the-fold weights (body 400, hero 900).
         @font-face declarations live in global.css. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter/inter-latin-400-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter/inter-latin-900-normal.woff2" crossorigin />

    <!-- Font Awesome loaded non-render-blocking (icons aren't needed for first paint) -->
    <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" /></noscript>

    {isHome && (
        <script type="application/ld+json" set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@graph': [
                {
                    '@type': 'Organization',
                    '@id': 'https://day-zero.com.au/#organization',
                    name: 'Day Zero Solutions Pty Ltd',
                    alternateName: 'Day Zero',
                    url: 'https://day-zero.com.au',
                    logo: 'https://day-zero.com.au/images/apple-touch-icon.png',
                    image: 'https://day-zero.com.au/images/apple-touch-icon.png',
                    slogan: 'From Day Zero to Day One.',
                    description: 'Australian software studio building operations software for regulated, high-stakes industries: aged care and healthcare, restaurants, and food trucks. Software grounded in the customer’s live data, regulation-aware, with a human making the final call.',
                    address: { '@type': 'PostalAddress', addressCountry: 'AU', addressRegion: 'QLD', addressLocality: 'Brisbane' },
                    contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: 'hello@day-zero.com.au', areaServed: 'AU', availableLanguage: 'English' },
                    identifier: [
                        { '@type': 'PropertyValue', propertyID: 'ACN', value: '698240907' },
                        { '@type': 'PropertyValue', propertyID: 'ABN', value: '95698240907' }
                    ],
                    knowsAbout: [
                        'IDDSI', 'Aged Care Quality Standards', 'AN-ACC', 'dietary management',
                        'clinical nutrition', 'HACCP', 'restaurant operations', 'food cost management',
                        'procurement and 3-way matching', 'menu engineering', 'queue management'
                    ],
                    sameAs: [
                        'https://www.linkedin.com/company/day-zero-solutions/',
                        'https://nutri-care.app',
                        'https://restroai.app',
                        'https://queuezero.app'
                    ]
                },
                {
                    '@type': 'WebSite',
                    '@id': 'https://day-zero.com.au/#website',
                    url: 'https://day-zero.com.au',
                    name: 'Day Zero',
                    inLanguage: 'en-AU',
                    publisher: { '@id': 'https://day-zero.com.au/#organization' }
                },
                {
                    '@type': 'SoftwareApplication',
                    name: 'NutriCare',
                    url: 'https://nutri-care.app',
                    applicationCategory: 'BusinessApplication',
                    operatingSystem: 'Web',
                    description: 'Dietary management and care intelligence for aged care and healthcare: IDDSI texture and allergen conflict detection at the point of order, clinical nutrition (MUST/GLIM/ESPEN), incident logging, FHIR R4 export, and multi-site operator dashboards.',
                    publisher: { '@id': 'https://day-zero.com.au/#organization' },
                    offers: { '@type': 'Offer', price: '10', priceCurrency: 'AUD', description: 'From A$10 per resident per month' }
                },
                {
                    '@type': 'SoftwareApplication',
                    name: 'RestroAI',
                    url: 'https://restroai.app',
                    applicationCategory: 'BusinessApplication',
                    operatingSystem: 'Web',
                    description: 'AI-native restaurant operating system: inventory, procurement with 3-way match and invoice OCR, recipe costing, menu engineering, and food-cost intelligence.',
                    publisher: { '@id': 'https://day-zero.com.au/#organization' },
                    offers: { '@type': 'Offer', price: '49', priceCurrency: 'AUD', description: 'From A$49 per month' }
                },
                {
                    '@type': 'SoftwareApplication',
                    name: 'QueueZero',
                    url: 'https://queuezero.app',
                    applicationCategory: 'BusinessApplication',
                    operatingSystem: 'Web',
                    description: 'Order-ahead and queue-busting for food trucks and pop-ups: QR menus, live wait times, order-ahead, and a kitchen display, with 0% commission.',
                    publisher: { '@id': 'https://day-zero.com.au/#organization' },
                    offers: { '@type': 'Offer', price: '49', priceCurrency: 'AUD', description: 'A$49 per month, or A$490 per year' }
                }
            ]
        })} />
    )}

    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LVLW70H83Z"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-LVLW70H83Z');
    </script>
</head>
<body class={bodyClass}>
    {isHome && <div class="scroll-progress" id="scrollProgress"></div>}

    <Nav isHome={isHome} />

    <main>
        <slot />
    </main>

    <Footer />

    <script>
        import '../scripts/nav.js';
    </script>
</body>
</html>
